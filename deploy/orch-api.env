# Default workflow = benchmark config S2 (best on 2026-10-27: 12/13 true passes, ~10 min/task on one GPU):
# consensus of ornith:35b + qwen3-coder:30b, planner gpt-oss:20b, no reviewer, one consensus repair round.
# Placement: ornith lives on the 3080 Ti (.131). qwen3-coder and the planner prefer AtomEve (.15) and move to the
# 3080 Ti whenever AtomEve's Ollama is stopped or lacks the model; both solvers on one host take turns.
# Model names are the bench-* variants (num_ctx 16384; num_predict 8192 for thinking models, else 3072).
ORCH_DIRECT=1
ORCH_SOLVERS=[["bench-ornith-35b","http://192.168.1.131:11434"],["bench-qwen3-coder-30b","http://192.168.1.15:11434"]]
ORCH_REASONER_CANDIDATES=[["bench-gpt-oss-20b","http://192.168.1.15:11434"]]
ORCH_CODER_CANDIDATES=[["bench-ornith-35b","http://192.168.1.131:11434"]]
ORCH_REPAIR_CODER_CANDIDATES=[["bench-ornith-35b","http://192.168.1.131:11434"]]
ORCH_FALLBACK_HOSTS=["http://192.168.1.131:11434","http://192.168.1.15:11434"]
ORCH_PLANNER=1
ORCH_REVIEWER=0
ORCH_HINTS=0
ORCH_VERIFY=0
ORCH_MAX_REPAIRS=2
ORCH_SOLVER_REPAIRS=2
ORCH_CONSENSUS_REPAIRS=1
ORCH_EDIT_FORMAT=diff
ORCH_AIDER_TIMEOUT=600
ORCH_CHECK_TIMEOUT=240
ORCH_LLM_TIMEOUT=900
ORCH_ALLOWED_ROOT=/projects
ORCH_RUNS_DIR=/runs
ORCH_API_MODEL=orch-consensus
